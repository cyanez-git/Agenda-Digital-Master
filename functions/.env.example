# Credenciales de Cloud Functions (copiá este archivo como .env y completá los valores)
# NUNCA subas el archivo .env al repositorio

OPENAI_API_KEY=your_openai_api_key_here

# Clave secreta para autenticar la API REST (generá una clave aleatoria larga y segura)
API_SECRET_KEY=your_random_secret_key_here

# Orígenes permitidos en CORS (separados por coma)
ALLOWED_ORIGINS=https://agendadigital-profesional.web.app,https://agendadigital-profesional.firebaseapp.com
